{
  "name": "pipeline-desk",
  "productName": "Pipeline Desk",
  "version": "1.0.0",
  "private": true,
  "description": "Компактные виджеты GitLab для Windows и Ubuntu",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.mjs",
    "test:desktop": "node tests/run-desktop.mjs",
    "test:package:linux": "node tests/package-linux.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package": "electron-packager . PipelineDesk --platform=win32 --arch=x64 --out=release --overwrite --asar --icon=assets/icon.ico --ignore=\"^/(tests|scripts|packaging|release|.github|.impeccable|Pipeline Desk.lnk)\""
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0"
  },
  "type": "module"
}
